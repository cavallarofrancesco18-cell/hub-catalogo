rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '4E6MSEuIXZeeo3j2taWIA7LbYcw2'
        || firestore.exists(/databases/(default)/documents/Admin/$(request.auth.uid))
      );
    }

    function isSeller() {
      return isSellerProfile()
        || (
          isSignedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'seller'
        );
    }

    function canAccessPerizie() {
      return isAdmin() || isSellerProfile() || isSeller();
    }

    function isHubSeller() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/seller/$(request.auth.uid))
        && (
          (
            firestore.get(/databases/(default)/documents/seller/$(request.auth.uid)).data.sellerType is string
            && firestore.get(/databases/(default)/documents/seller/$(request.auth.uid)).data.sellerType.matches('^\\s*[Hh][Uu][Bb]\\s*$')
          )
        );
    }

    function isSellerProfile() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/seller/$(request.auth.uid));
    }

    function canManageContractFiles() {
      return isAdmin() || isHubSeller();
    }

    function isPublicVehicle(vehicleId) {
      return firestore.exists(/databases/(default)/documents/vehicles/$(vehicleId))
        && firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)).data.adminOnly == false;
    }

    match /seller-company-logos/{sellerId}/{allPaths=**} {
      allow get: if isAdmin() || (isSellerProfile() && request.auth.uid == sellerId);
      allow list: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /seller-company-documents/{sellerId}/{allPaths=**} {
      allow get: if isAdmin() || (isSellerProfile() && request.auth.uid == sellerId);
      allow list: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Rule for vehicle images.
    // Public 'get' for catalog display.
    // 'write' also for HUB sellers to manage ad media from admin pages.
    match /download/{vehicleId}/{allPaths=**} {
      allow get: if isAdmin() || isPublicVehicle(vehicleId);
      allow list: if isAdmin() || (isSeller() && isPublicVehicle(vehicleId));
      allow write: if isAdmin() || (isHubSeller() && isPublicVehicle(vehicleId));
    }

    // Private perizie: visible only to registered sellers and admins.
    match /perizie/{vehicleId}/{allPaths=**} {
      allow get, list: if isAdmin() || (isSignedIn() && isPublicVehicle(vehicleId));
      allow write: if isAdmin();
    }

    // Signed contracts uploaded after contract generation.
    match /contracts/{vehicleId}/signed/{allPaths=**} {
      allow get, write: if canManageContractFiles();
    }

    match /contracts/{vehicleId}/{allPaths=**} {
      allow get, list, write: if isAdmin() || (canManageContractFiles() && isPublicVehicle(vehicleId));
    }

    // Rule for form documents.
    // Authenticated users can 'get' forms.
    // Admins can 'list' and 'write' to manage the forms.
    match /forms/{formId}/{allPaths=**} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    // Shared HUB documents: admin and seller HUB only.
    match /hub-documents/{ownerUid}/{allPaths=**} {
      allow get, list: if isAdmin() || isHubSeller();
      allow write: if isAdmin() || (isHubSeller() && request.auth.uid == ownerUid);
    }

    // Rule for newsletter attachments uploaded by admins.
    // Files are sent via secure download URLs generated after upload.
    match /newsletter-attachments/{adminUid}/{allPaths=**} {
      allow get: if isAdmin();
      allow list, write: if isAdmin();
    }

    match /agent-vehicle-reports/images/{userId}/{reportId}/{allPaths=**} {
      allow get, list, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /agent-vehicle-reports/attachments/{userId}/{reportId}/{allPaths=**} {
      allow get, list, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Vehicle documents: admin and sellers can read/list; only admins and HUB sellers can write.
    match /vehicle-documents/{vehicleId}/{allPaths=**} {
      allow get, list: if isAdmin() || (isSignedIn() && isPublicVehicle(vehicleId));
      allow write: if (isHubSeller() && isPublicVehicle(vehicleId)) || isAdmin();
    }

    // Publicly readable logos for branding
    match /LOGHI/{allPaths=**} {
      allow get: if true;
    }
    match /{fileName} {
      allow get: if fileName == 'HUB - logo tutti formati_Tavola disegno 1 copia 4 (4).png'
        || fileName == 'logo-restart-mobility-white-300x154.png'
        || fileName == 'WhatsApp Image 2026-03-09 at 16.41.30.jpeg'
        || fileName == 'Logo-1 trasparente.png'
        || fileName == 'MGV_logo.png';
    }
  }
}
